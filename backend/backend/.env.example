PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fg_debt_advice
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:8080
RESET_TOKEN_MINUTES=30
# Required in production: long random value used to encrypt secrets at rest (MFA secrets)
DATA_ENCRYPTION_KEY=replace-with-another-long-random-secret
# Compliance reminder emails (optional in development: without SMTP_HOST they are written to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FG Compliance <compliance@your-firm.co.uk>
# Daily digest time (hour, 0-23) and time zone
REMINDER_HOUR=8
REMINDER_TIMEZONE=Europe/London
# AI features (document review, assistant, analysis). AI_PROVIDER is openai or anthropic; leave the key empty to keep AI off.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: defaults to gpt-5.5 (openai) or claude-opus-5-5 (anthropic)
AI_MODEL=
AI_EFFORT=high
# Where uploaded documents are stored (encrypted)
UPLOAD_DIR=uploads
# Daily backups: folder, hour (0-23), how many to keep; BACKUP_SCHEDULE=off disables them
BACKUP_DIR=backups
BACKUP_HOUR=2
BACKUP_KEEP=14
BACKUP_SCHEDULE=on
